Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 230; 235; 239
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 170; 180
    - Class: rviz_default_plugins/Map
      Name: Original SLAM map
      Enabled: true
      Alpha: 0.9
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 30; 100; 230
      Topic:
        Value: /plan
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/LaserScan
      Name: Real laser scan
      Enabled: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /smartcar/exam_goal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Target Frame: map
      Scale: 52
      X: 5
      Y: 3
      Angle: 0
Window Geometry:
  Width: 1100
  Height: 800
