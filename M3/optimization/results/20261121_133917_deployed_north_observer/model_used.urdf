    <origin rpy="-1.5707963 0 -1.5707963" xyz="0 0 0"/>
  </joint>
  <!-- ==================== ros2_control 硬件接口 ==================== -->
  <ros2_control name="SmartCarSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <!-- 左前转向关节 -->
    <joint name="front_left_steering_joint">
      <command_interface name="position">
        <param name="min">-0.5236</param>
        <param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 右前转向关节 -->
    <joint name="front_right_steering_joint">
      <command_interface name="position">
        <param name="min">-0.5236</param>
        <param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 左前驱动轮 -->
    <joint name="front_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 右前驱动轮 -->
    <joint name="front_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 左后驱动轮 -->
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 右后驱动轮 -->
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- ==================== Gazebo 插件配置 ==================== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <ros>
        <!-- 把控制器的 TF 输出接到全局 /tf -->
        <remapping>ackermann_steering_controller/tf_odometry:=/tf</remapping>
        <remapping>ackermann_steering_controller/reference_unstamped:=cmd_vel</remapping>
        <!-- 可选：同时重映射里程计话题，方便 RViz 显示 -->
        <remapping>ackermann_steering_controller/odometry:=odom</remapping>
      </ros>
      <parameters>/home/ubuntu2204/smartcar-m1-m3/install_ros/smart_car_description/share/smart_car_description/config/ackermann_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- ==================== Gazebo 传感器插件 ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="laserscan" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="laserscan">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
